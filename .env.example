# BytePlus ModelArk
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Server-only generation defaults. These values are coupled to the fixed output
# profiles and flat credit costs below; update each model/profile/cost pair together.
MODELARK_IMAGE_MODEL=seedream-5-0-lite-260128
MODELARK_VIDEO_MODEL=dreamina-seedance-2-0-fast-260128

# Phase 2/3: Director and Marketing agents (chat completions). Confirmed via
# Console -> ModelArk -> Model Square ("Dola-Seed-2.1-turbo", reasoning/agent
# model, text output) and verified live.
MODELARK_CHAT_MODEL=dola-seed-2-1-turbo-260628

# Database (local docker-compose defaults shown)
DATABASE_URL=postgresql://app:app@localhost:5432/custom_interface

# Queue
REDIS_URL=redis://localhost:6379

# BytePlus TOS (object storage) — for generated assets
# Client: @volcengine/tos-sdk (BytePlus TOS shares this SDK with Volcengine TOS —
# confirmed via docs.byteplus.com/en/docs/tos/Quick-start-node-js-sdk)
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=

# Phase 3: BytePlus Seed Speech (TTS) — a genuinely separate product from
# ModelArk (separate console, separate API key, x-api-key auth instead of
# Authorization: Bearer). See MODELARK_VOICE_AVATAR_REFERENCE.md.
BYTEPLUS_VOICE_API_KEY=
BYTEPLUS_VOICE_BASE_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3

# Voice generation defaults. MODELARK_VOICE_MODEL records the confirmed Seed
# Speech resource ID; the worker does not actually read Job.model for voice
# (the speaker is fixed in VOICE_PROFILE), but the column is required and this
# keeps the Job row self-documenting. VOICE_CREDITS_COST is a conservative
# placeholder — real BytePlus per-request voice pricing has not been confirmed.
MODELARK_VOICE_MODEL=seed-tts-2.0
VOICE_CREDITS_COST=1

# Auth.js — email magic link (primary) + Google OAuth (one-click)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email provider (magic link) — Resend is the simplest Auth.js integration;
# swap for another transactional email provider if you prefer
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@yourdomain.com

# Google OAuth — create credentials at console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — not used in Phase 1 (see ARCHITECTURE.md Section 2 for why);
# add here later only if you want a developer/prosumer sign-in option
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Who may sign in. An entry starting with "@" admits a whole email domain; any
# other entry admits exactly that address. Comma-separated.
#
# Empty is open in development, because a local box has no strangers on it.
# In production an empty value admits NOBODY — every sign-in mints a welcome
# grant and every credit is real BytePlus spend, so the door is shut until
# someone is named. See infra/.env.production.example.
ALLOWED_SIGN_IN=

# Phase-1 dev welcome grant — see ARCHITECTURE.md Section 8 for why this is
# separate from real topups and not meant to survive past Phase 1 unguarded
INITIAL_CREDITS=100

# Job credit costs — anchored so 1 credit ≈ $0.04 real BytePlus spend (Seedream's
# actual cost). Image and voice are flat per request.
IMAGE_CREDITS_COST=1

# Video is priced per second and scaled by resolution, because duration and
# resolution are user-selectable (they used to be hardcoded to 5s/720p). The
# default reproduces the old flat price exactly for the old fixed profile:
#   2.8 credits/sec × 5s × 1.0 (720p) = 14 credits
# Resolution multipliers live in packages/shared-types/src/generation.ts and are
# marked UNCONFIRMED — verify against real BytePlus per-resolution pricing.
# Still coupled to the video model: changing MODELARK_VIDEO_MODEL without
# revisiting this rate silently mis-bills. See ARCHITECTURE.md Section 8.
VIDEO_CREDITS_PER_SECOND_720P=2.8

# Count both queued and processing jobs inside the submission transaction.
MAX_IN_FLIGHT_JOBS=3
