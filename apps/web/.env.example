# Next.js only reads .env files from this directory (apps/web), not the repo
# root — so this file mirrors the root .env.example. Copy this to apps/web/.env
# with real values; keep it in sync with the root file and apps/worker/.env.

# Server-only generation defaults (must match apps/worker/.env — see
# ARCHITECTURE.md Section 8 for why model and credit cost are coupled)
MODELARK_IMAGE_MODEL=seedream-5-0-lite-260128
MODELARK_VIDEO_MODEL=dreamina-seedance-2-0-fast-260128
IMAGE_CREDITS_COST=1
VIDEO_CREDITS_COST=14
MAX_IN_FLIGHT_JOBS=3

# Database
DATABASE_URL=postgresql://app:app@localhost:5432/custom_interface

# Queue / pub-sub
REDIS_URL=redis://localhost:6379

# BytePlus TOS — used here only to generate short-lived signed download URLs
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=

# Auth.js — email magic link (primary) + Google OAuth (one-click)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@yourdomain.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase-1 dev welcome grant — see ARCHITECTURE.md Section 8
INITIAL_CREDITS=100
