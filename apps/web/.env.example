# Next.js only reads .env files from this directory (apps/web), not the repo
# root — so this file mirrors the root .env.example. Copy this to apps/web/.env
# with real values; keep it in sync with the root file and apps/worker/.env.

# Server-only generation defaults (must match apps/worker/.env — see
# ARCHITECTURE.md Section 8 for why model and credit cost are coupled)
MODELARK_IMAGE_MODEL=seedream-5-0-lite-260128
MODELARK_VIDEO_MODEL=dreamina-seedance-2-0-fast-260128
IMAGE_CREDITS_COST=1
# Video is priced per second, scaled by resolution (duration/resolution are now
# user-selectable). 2.8 × 5s × 1.0 = 14 preserves the old flat price for the old
# fixed 5s/720p profile. See .env.example at the repo root for the full note.
VIDEO_CREDITS_PER_SECOND_720P=2.8
MAX_IN_FLIGHT_JOBS=3

# Phase 2/3: Director and Marketing agents call ModelArk's chat completions
# directly from this app (unlike image/video jobs, which only ever run in
# the worker) -- so this app needs ARK_API_KEY too. MODELARK_CHAT_MODEL
# confirmed via Console -> ModelArk -> Model Square ("Dola-Seed-2.1-turbo").
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_CHAT_MODEL=dola-seed-2-1-turbo-260628

# Database
DATABASE_URL=postgresql://app:app@localhost:5432/custom_interface

# Queue / pub-sub
REDIS_URL=redis://localhost:6379

# BytePlus TOS — used here to generate short-lived signed download URLs, and (Phase 3
# Speech-to-Text) to upload the audio the user submits for transcription
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=
TOS_BUCKET=

# Phase 3: Speech-to-Text calls BytePlus Voice directly from this app (like Director/
# Marketing call ModelArk directly) -- not queued through the worker, since it's a
# request/response agent-style call, not a paid media generation.
BYTEPLUS_VOICE_API_KEY=
BYTEPLUS_VOICE_BASE_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3

# Auth.js — email magic link (primary) + Google OAuth (one-click)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@yourdomain.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase-1 dev welcome grant — see ARCHITECTURE.md Section 8
INITIAL_CREDITS=100
