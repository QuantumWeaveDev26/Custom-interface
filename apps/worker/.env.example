# Plain Node.js has no built-in .env loading of its own here — the "start"
# script in package.json points --env-file at this exact filename, so copy
# this to apps/worker/.env with real values (keep it in sync with the root
# file and apps/web/.env).

# BytePlus ModelArk
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Server-only generation defaults (must match apps/web/.env)
MODELARK_IMAGE_MODEL=seedream-5-0-lite-260128
MODELARK_VIDEO_MODEL=dreamina-seedance-2-0-fast-260128

# Database
DATABASE_URL=postgresql://app:app@localhost:5432/custom_interface

# Queue
REDIS_URL=redis://localhost:6379

# BytePlus TOS (object storage) — for generated assets
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=
