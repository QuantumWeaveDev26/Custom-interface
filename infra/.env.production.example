# Copy to infra/.env.production on the server and fill in. That file is the one
# thing on the machine that must never be committed, pasted into a chat, or
# shown on a shared screen — every key in it spends real money.
#
#   cp infra/.env.production.example infra/.env.production
#   chmod 600 infra/.env.production

# ---------------------------------------------------------------- identity ---
# The domain the platform answers on. Its A record must already point at this
# server before Caddy can obtain a certificate.
SITE_DOMAIN=studio.yourcompany.com
NEXTAUTH_URL=https://studio.yourcompany.com
AUTH_URL=https://studio.yourcompany.com

# Sessions are signed with this. Generate once, never reuse the dev value:
#   openssl rand -base64 32
# Changing it later signs everyone out; it does not delete anything.
NEXTAUTH_SECRET=

# ------------------------------------------------------------ who may enter ---
# THE MOST IMPORTANT LINE IN THIS FILE.
#
# Every sign-in creates an account with a welcome grant, and every credit is
# real BytePlus spend. On a public URL an empty list would mean anyone on earth
# with a Google account could sign up and bill the studio — so in production an
# empty list admits nobody at all, and the platform is opened by naming who is
# allowed in.
#
# "@company.com" admits everyone at that domain; a bare address admits exactly
# that person. Comma-separated, no spaces needed.
ALLOWED_SIGN_IN=@yourcompany.com

# How many credits a newly admitted account starts with.
INITIAL_CREDITS=100

# ---------------------------------------------------------------- database ---
# POSTGRES_* create the database inside the container; DATABASE_URL is how the
# app reaches it. The password appears in both — change it in both, together.
# The host is "postgres" because that is the service name on the compose
# network, not localhost.
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=creative_ai
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/creative_ai

REDIS_URL=redis://redis:6379

# ----------------------------------------------------------- BytePlus ModelArk ---
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

MODELARK_IMAGE_MODEL=seedream-5-0-lite-260128
MODELARK_VIDEO_MODEL=dreamina-seedance-2-0-fast-260128
MODELARK_CHAT_MODEL=dola-seed-2-1-turbo-260628
MODELARK_EMBEDDING_MODEL=skylark-embedding-vision-250615

# ------------------------------------------------- BytePlus TOS (object storage) ---
# Where every generated image, clip and film is stored. Keep the bucket in the
# same region as this server: the worker moves hundreds of megabytes per film,
# and cross-region transfer is both slower and billed.
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=

# ----------------------------------------------- BytePlus Seed Speech (voice) ---
# A separate product with a separate key from ModelArk's.
BYTEPLUS_VOICE_API_KEY=
BYTEPLUS_VOICE_BASE_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3
MODELARK_VOICE_MODEL=seed-tts-2.0

# ------------------------------------------------------------------ sign-in ---
# Google is the least friction if the company already uses Google Workspace.
# The redirect URI to register is:
#   https://studio.yourcompany.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic link. Only needed if the company does not use Google Workspace.
# Requires a domain verified with Resend (DNS records your IT team must add).
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@yourcompany.com

# ------------------------------------------------------------------ pricing ---
# 1 credit is roughly $0.04 of real BytePlus spend. Raising these does not save
# money; it only makes each job cost more of an account's balance.
IMAGE_CREDITS_COST=1
VOICE_CREDITS_COST=1
VIDEO_CREDITS_PER_SECOND_720P=2.8

# How many jobs one account may have queued or running at once.
MAX_IN_FLIGHT_JOBS=3
