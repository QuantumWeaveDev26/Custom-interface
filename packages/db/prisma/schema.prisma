generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique // kept required (not nullable, unlike
                                             // Auth.js's reference schema) — both
                                             // Phase 1 providers always supply email
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime            @default(now())
  creditBalance Int                 @default(0)
  // Embedding a generated asset costs provider tokens, so indexing on
  // completion is something the user turns on, not something that happens to
  // them. Off by default for that reason alone.
  autoIndexAssets Boolean           @default(false)
  jobs          Job[]
  characters    Character[]
  ledger        CreditLedgerEntry[]
  accounts      Account[]
  sessions      Session[]
}

// --- Auth.js (@auth/prisma-adapter) required models below ---
// Standard adapter contract — do not rename fields, the adapter reads these by name.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CreditLedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int // positive = top-up, negative = spend
  reason    String // "welcome_grant" | "topup" | "generation:<jobId>" | "refund:<jobId>"
  createdAt DateTime @default(now())
}

model Job {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String // "image" | "video" | "voice" | "avatar"
  model          String // e.g. "seedream-5-0-pro", "seedance-2-5"
  status         String // "queued" | "processing" | "complete" | "failed"
  // { prompt, params } — params is a GenerationParams discriminated union
  // (packages/shared-types/src/generation.ts). Stored rather than recomputed so
  // a later config change never retroactively alters what a job actually ran.
  inputParams    Json
  externalTaskId String?
  // Progress through a chained video job: { completedRounds, assetIds }.
  // Null for every single-round job. It exists because a sixteen-round chain is
  // most of an hour of paid work, and a worker restart at round twelve must
  // resume there rather than regenerate — and recharge — the eleven clips that
  // already exist.
  chainProgress  Json?
  errorMessage   String?
  creditsCost    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assets         Asset[]
  inputAssets    JobInputAsset[]
}

model Asset {
  id           String   @id @default(cuid())
  // Null for user-uploaded assets: they have no generating job. Every asset
  // still belongs to exactly one user via userId, which is what ownership
  // checks read — jobId is provenance, not authorization.
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id])
  userId       String
  type         String // "image" | "video" | "audio"
  storageUrl   String
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  // Null means private, which is every asset until its owner says otherwise.
  // A timestamp rather than a boolean because the feed is ordered by when a
  // thing was shared, not by when it was made — an old asset published today
  // belongs at the top.
  publishedAt  DateTime?
  usedAsInput  JobInputAsset[]
  characterRefs CharacterReference[]
  embedding    AssetEmbedding?

  @@index([publishedAt])
}

// A semantic vector for one asset, used for search and "more like this".
//
// The vector is stored as a plain Float[] rather than a pgvector column
// because pgvector is not installed on the target Postgres, and similarity is
// computed in application code. That is fine for a per-user library of this
// size and avoids making the whole feature wait on a database extension; see
// PROJECT_STATE.md for when it stops being fine.
model AssetEmbedding {
  assetId    String   @id
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId     String
  // Kept alongside the vector because a model or dimension change makes old
  // vectors incomparable — mixing them silently returns nonsense rankings.
  model      String
  dimensions Int
  vector     Float[]
  createdAt  DateTime @default(now())

  @@index([userId])
}

// A named, reusable set of reference images — the "Soul ID" equivalent.
// Without this, references are re-picked from scratch on every generation,
// which is the difference between a demo and something usable daily.
model Character {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime             @default(now())
  references CharacterReference[]

  // Names are the handle a user reasons about, so they must be unambiguous
  // within an account — but only within one, so two users can both have "Me".
  @@unique([userId, name])
  @@index([userId])
}

model CharacterReference {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id])
  // Reference order is meaningful downstream ("image 1", "image 2").
  position    Int       @default(0)

  @@unique([characterId, assetId])
  @@index([assetId])
}

// Lets a job consume assets the user already owns — image-to-video, keyframe
// control, multi-reference (character consistency), video extension/editing.
// A join table rather than a JSON array of IDs so the reference is a real FK:
// asset lineage stays queryable in both directions, and a dangling reference to
// a deleted asset is impossible.
model JobInputAsset {
  id       String @id @default(cuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id])
  // "first_frame" | "last_frame" | "reference" | "source_video"
  role     String
  // Ordering within a role; only meaningful for "reference", which can repeat.
  position Int    @default(0)

  @@unique([jobId, assetId, role])
  @@index([assetId])
}
