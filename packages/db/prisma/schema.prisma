generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique // kept required (not nullable, unlike
                                             // Auth.js's reference schema) — both
                                             // Phase 1 providers always supply email
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime            @default(now())
  creditBalance Int                 @default(0)
  jobs          Job[]
  ledger        CreditLedgerEntry[]
  accounts      Account[]
  sessions      Session[]
}

// --- Auth.js (@auth/prisma-adapter) required models below ---
// Standard adapter contract — do not rename fields, the adapter reads these by name.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CreditLedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int // positive = top-up, negative = spend
  reason    String // "welcome_grant" | "topup" | "generation:<jobId>" | "refund:<jobId>"
  createdAt DateTime @default(now())
}

model Job {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String // "image" | "video" | "voice" | "avatar"
  model          String // e.g. "seedream-5-0-pro", "seedance-2-5"
  status         String // "queued" | "processing" | "complete" | "failed"
  // { prompt, params } — params is a GenerationParams discriminated union
  // (packages/shared-types/src/generation.ts). Stored rather than recomputed so
  // a later config change never retroactively alters what a job actually ran.
  inputParams    Json
  externalTaskId String?
  errorMessage   String?
  creditsCost    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assets         Asset[]
  inputAssets    JobInputAsset[]
}

model Asset {
  id           String   @id @default(cuid())
  // Null for user-uploaded assets: they have no generating job. Every asset
  // still belongs to exactly one user via userId, which is what ownership
  // checks read — jobId is provenance, not authorization.
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id])
  userId       String
  type         String // "image" | "video" | "audio"
  storageUrl   String
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  usedAsInput  JobInputAsset[]
}

// Lets a job consume assets the user already owns — image-to-video, keyframe
// control, multi-reference (character consistency), video extension/editing.
// A join table rather than a JSON array of IDs so the reference is a real FK:
// asset lineage stays queryable in both directions, and a dangling reference to
// a deleted asset is impossible.
model JobInputAsset {
  id       String @id @default(cuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id])
  // "first_frame" | "last_frame" | "reference" | "source_video"
  role     String
  // Ordering within a role; only meaningful for "reference", which can repeat.
  position Int    @default(0)

  @@unique([jobId, assetId, role])
  @@index([assetId])
}
